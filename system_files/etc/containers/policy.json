{
  "default": [{"type": "insecureAcceptAnything"}],
  "transports": {
    "docker": {
      "ghcr.io/egergo": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/ghcr.io-egergo.pub",
          "signedIdentity": {"type": "matchRepository"}
        }
      ]
    }
  }
}
