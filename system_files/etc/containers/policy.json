{
  "default": [{"type": "reject"}],
  "transports": {
    "docker": {
      "quay.io/fedora-ostree-desktops": [
        {"type": "insecureAcceptAnything"}
      ],
      "ghcr.io/egergo": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/ghcr.io-egergo.pub",
          "signedIdentity": {"type": "matchRepository"}
        }
      ]
    },
    "docker-daemon": {
      "": [{"type": "insecureAcceptAnything"}]
    }
  }
}
